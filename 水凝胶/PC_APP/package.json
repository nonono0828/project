{
  "name": "hydrogel-hand-controller",
  "version": "1.0.0",
  "description": "3x3 hydrogel sensor driven robotic hand visualizer",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Hydrogel Hand Project",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5173\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "dist:win": "npm run test && npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "@serialport/parser-readline": "^13.0.0",
    "lucide": "^0.468.0",
    "serialport": "^13.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^38.1.2",
    "electron-builder": "^26.0.12",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "cn.hydrogel.handcontroller",
    "productName": "Hydrogel Hand",
    "asar": true,
    "asarUnpack": [
      "node_modules/@serialport/bindings-cpp/**"
    ],
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Hydrogel-Hand-${version}-portable.${ext}"
    }
  }
}
